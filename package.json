{
  "name": "at-jenkins",
  "displayName": "%atJenkins.displayName%",
  "description": "%atJenkins.description%",
  "version": "0.1.0",
  "publisher": "local",
  "icon": "media/at-jenkins-icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xwamt/At-jenkins.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "jenkins",
    "pipeline",
    "mcp",
    "at-series"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "atJenkins",
          "title": "%atJenkins.viewsContainer.title%",
          "icon": "media/at-jenkins-activity.svg"
        }
      ]
    },
    "views": {
      "atJenkins": [
        {
          "id": "atJenkins.instances",
          "name": "%atJenkins.view.instances.name%"
        },
        {
          "id": "atJenkins.jobs",
          "name": "%atJenkins.view.jobs.name%"
        }
      ]
    },
    "commands": [
      {
        "command": "atJenkins.addInstance",
        "category": "%atJenkins.displayName%",
        "title": "%atJenkins.command.addInstance.title%",
        "icon": "$(add)"
      },
      {
        "command": "atJenkins.editInstance",
        "title": "%atJenkins.command.editInstance.title%",
        "icon": "$(edit)",
        "category": "%atJenkins.displayName%"
      },
      {
        "command": "atJenkins.deleteInstance",
        "title": "%atJenkins.command.deleteInstance.title%",
        "icon": "$(trash)",
        "category": "%atJenkins.displayName%"
      },
      {
        "command": "atJenkins.testConnection",
        "title": "%atJenkins.command.testConnection.title%",
        "icon": "$(debug-disconnect)",
        "category": "%atJenkins.displayName%"
      },
      {
        "command": "atJenkins.refreshInstances",
        "title": "%atJenkins.command.refreshInstances.title%",
        "icon": "$(refresh)",
        "category": "%atJenkins.displayName%"
      },
      {
        "command": "atJenkins.setActiveInstance",
        "title": "%atJenkins.command.setActiveInstance.title%",
        "icon": "$(check)",
        "category": "%atJenkins.displayName%"
      },
      {
        "command": "atJenkins.refreshJobs",
        "title": "%atJenkins.command.refreshJobs.title%",
        "icon": "$(refresh)",
        "category": "%atJenkins.displayName%"
      },
      {
        "command": "atJenkins.loadMoreBuilds",
        "title": "%atJenkins.command.loadMoreBuilds.title%",
        "icon": "$(more)",
        "category": "%atJenkins.displayName%"
      },
      {
        "command": "atJenkins.openPipelineScript",
        "title": "%atJenkins.command.openPipelineScript.title%",
        "icon": "$(file-code)",
        "category": "%atJenkins.displayName%"
      },
      {
        "command": "atJenkins.openJobSummary",
        "title": "%atJenkins.command.openJobSummary.title%",
        "icon": "$(info)",
        "category": "%atJenkins.displayName%"
      },
      {
        "command": "atJenkins.openBuildLog",
        "title": "%atJenkins.command.openBuildLog.title%",
        "icon": "$(output)",
        "category": "%atJenkins.displayName%"
      },
      {
        "command": "atJenkins.triggerBuild",
        "title": "%atJenkins.command.triggerBuild.title%",
        "icon": "$(play)",
        "category": "%atJenkins.displayName%"
      },
      {
        "command": "atJenkins.stopBuild",
        "title": "%atJenkins.command.stopBuild.title%",
        "icon": "$(debug-stop)",
        "category": "%atJenkins.displayName%"
      },
      {
        "command": "atJenkins.followBuildLogInOutput",
        "title": "%atJenkins.command.followBuildLogInOutput.title%",
        "icon": "$(terminal)",
        "category": "%atJenkins.displayName%"
      },
      {
        "command": "atJenkins.openInJenkins",
        "title": "%atJenkins.command.openInJenkins.title%",
        "icon": "$(link-external)",
        "category": "%atJenkins.displayName%"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "atJenkins.openJobSummary",
          "when": "false"
        },
        {
          "command": "atJenkins.loadMoreBuilds",
          "when": "false"
        },
        {
          "command": "atJenkins.openPipelineScript",
          "when": "false"
        },
        {
          "command": "atJenkins.openBuildLog",
          "when": "false"
        },
        {
          "command": "atJenkins.triggerBuild",
          "when": "false"
        },
        {
          "command": "atJenkins.stopBuild",
          "when": "false"
        },
        {
          "command": "atJenkins.followBuildLogInOutput",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "atJenkins.addInstance",
          "when": "view == atJenkins.instances",
          "group": "navigation@1"
        },
        {
          "command": "atJenkins.refreshInstances",
          "when": "view == atJenkins.instances",
          "group": "navigation@2"
        },
        {
          "command": "atJenkins.refreshJobs",
          "when": "view == atJenkins.jobs",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "atJenkins.setActiveInstance",
          "when": "view == atJenkins.instances && viewItem == atJenkins.instance.inactive",
          "group": "inline@1"
        },
        {
          "command": "atJenkins.testConnection",
          "when": "view == atJenkins.instances && viewItem =~ /^atJenkins\\.instance/",
          "group": "atJenkins.action@1"
        },
        {
          "command": "atJenkins.editInstance",
          "when": "view == atJenkins.instances && viewItem =~ /^atJenkins\\.instance/",
          "group": "atJenkins.action@2"
        },
        {
          "command": "atJenkins.deleteInstance",
          "when": "view == atJenkins.instances && viewItem =~ /^atJenkins\\.instance/",
          "group": "atJenkins.action@3"
        },
        {
          "command": "atJenkins.loadMoreBuilds",
          "when": "view == atJenkins.jobs && viewItem == jenkinsBuildsMore",
          "group": "inline@1"
        },
        {
          "command": "atJenkins.triggerBuild",
          "when": "view == atJenkins.jobs && (viewItem == jenkinsJob || viewItem =~ /^jenkinsJob\\./)",
          "group": "inline@1"
        },
        {
          "command": "atJenkins.openPipelineScript",
          "when": "view == atJenkins.jobs && viewItem == jenkinsJob.pipeline",
          "group": "inline@2"
        },
        {
          "command": "atJenkins.openJobSummary",
          "when": "view == atJenkins.jobs && (viewItem == jenkinsJob.freestyle || viewItem == jenkinsJob || viewItem == jenkinsJob.pipeline)",
          "group": "inline@3"
        },
        {
          "command": "atJenkins.openBuildLog",
          "when": "view == atJenkins.jobs && (viewItem == jenkinsBuild || viewItem =~ /^jenkinsBuild\\./)",
          "group": "inline@1"
        },
        {
          "command": "atJenkins.stopBuild",
          "when": "view == atJenkins.jobs && viewItem == jenkinsBuild.building",
          "group": "inline@2"
        },
        {
          "command": "atJenkins.followBuildLogInOutput",
          "when": "view == atJenkins.jobs && (viewItem == jenkinsBuild || viewItem =~ /^jenkinsBuild\\./)",
          "group": "atJenkins.action@1"
        },
        {
          "command": "atJenkins.openInJenkins",
          "when": "view == atJenkins.instances && viewItem =~ /^atJenkins\\.instance/",
          "group": "atJenkins.action@4"
        },
        {
          "command": "atJenkins.openInJenkins",
          "when": "view == atJenkins.jobs && (viewItem =~ /^jenkinsFolder/ || viewItem == jenkinsJob || viewItem =~ /^jenkinsJob\\./ || viewItem == jenkinsBuild || viewItem =~ /^jenkinsBuild\\./)",
          "group": "atJenkins.action@2"
        }
      ],
      "editor/title": [
        {
          "command": "atJenkins.openInJenkins",
          "when": "resourceScheme == at-jenkins || resourceScheme == at-jenkins-draft",
          "group": "navigation"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "atJenkins.instances",
        "contents": "%atJenkins.welcome.instances%"
      },
      {
        "view": "atJenkins.jobs",
        "contents": "%atJenkins.welcome.jobs%"
      }
    ],
    "configuration": {
      "title": "%atJenkins.displayName%",
      "properties": {
        "atJenkins.builds.pageSize": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "maximum": 100,
          "scope": "window",
          "description": "%atJenkins.config.builds.pageSize%"
        },
        "atJenkins.log.pollIntervalMs": {
          "type": "number",
          "default": 3000,
          "minimum": 500,
          "maximum": 60000,
          "scope": "window",
          "description": "%atJenkins.config.log.pollIntervalMs%"
        },
        "atJenkins.log.uiTailBytes": {
          "type": "number",
          "default": 2097152,
          "minimum": 16384,
          "maximum": 33554432,
          "scope": "window",
          "description": "%atJenkins.config.log.uiTailBytes%"
        },
        "atJenkins.follow.pollIntervalMs": {
          "type": "number",
          "default": 2000,
          "minimum": 500,
          "maximum": 60000,
          "scope": "window",
          "description": "%atJenkins.config.follow.pollIntervalMs%"
        },
        "atJenkins.follow.maxPolls": {
          "type": "number",
          "default": 150,
          "minimum": 10,
          "maximum": 10000,
          "scope": "window",
          "description": "%atJenkins.config.follow.maxPolls%"
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "npm run compile && npx @vscode/vsce package --no-dependencies --allow-missing-repository --no-rewrite-relative-links"
  },
  "dependencies": {
    "@at-series/mcp-hub": "^0.3.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
